# Production Environment Configuration
NODE_ENV=production
PORT=5000

# Database Configuration (Use DATABASE_URL or individual PG* parameters)
# Examples:
# For AWS RDS / Supabase / Neon / Render / Railway:
# DATABASE_URL=postgresql://username:strong_password@ep-host.region.aws.neon.tech/realestate_db?sslmode=require
DATABASE_URL=postgresql://postgres:admin@localhost:5432/realestate_db

# Or Individual PostgreSQL credentials:
PGHOST=localhost
PGPORT=5432
PGDATABASE=realestate_db
PGUSER=postgres
PGPASSWORD=admin
PGSSL=false
PGMAX=25
PG_IDLE_TIMEOUT=30000
PG_CONNECT_TIMEOUT=5000

# Security Keys (Generate a 64+ char random string in production)
JWT_SECRET=production_strong_secret_key_change_me_before_deploying_live_2026

# Allowed Frontend Origins (Comma separated or * for open)
CORS_ORIGIN=http://localhost:5173,https://yourdomain.com

# Serve Compiled Frontend SPA directly from Express (true/false)
SERVE_FRONTEND=true
